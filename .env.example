
# Application
APP_ENV=development
APP_NAME=screenshot-to-frontend
DEBUG=true

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-6
OPENAI_API_KEY=your_api_key_here

# Alternative AWS Bedrock configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
BEDROCK_MODEL_ID=your_bedrock_model_id

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_URL=http://localhost:5173

# PDF Processing
MAX_UPLOAD_SIZE_MB=50
MAX_PDF_PAGES=100
OCR_ENABLED=true

# Agent Configuration
MAX_ITERATIONS=5
SIMILARITY_THRESHOLD=0.90

# Browser
PLAYWRIGHT_HEADLESS=true
BROWSER_TIMEOUT=60000

# Storage
UPLOAD_DIR=uploads
GENERATED_PROJECT_DIR=generated_projects
